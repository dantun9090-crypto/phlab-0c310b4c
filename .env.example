# Wallid payment reconciliation cron.
# Shared between the /api/public/hooks/reconcile-payments route (reads it as
# process.env.CRON_SECRET) and the wallid-reconcile.yml GitHub Actions
# workflow (reads it as secrets.CRON_SECRET). Rotate in lockstep.
CRON_SECRET=your-cron-secret-here

# Google Ads offline conversion import (optional override).
# The /api/public/hooks/offline-conversions feed (fetched daily by Ads →
# Goals → Conversions → Uploads → Schedules; auth = CRON_SECRET as `key`)
# labels every row with this conversion-action name. It must EXACTLY match
# the action name shown in Ads → Goals → conversion actions. Default:
# "Purchase (website)".
ADS_IMPORT_CONVERSION_NAME=

# Google Ads purchase conversion label (client-safe, build time).
# Optional override. The live label for AW-18173004380 is hardcoded as the
# default in src/lib/analytics.ts (ksL0COOWrt0cENyUyNlD) — only set this if
# you need a different conversion action per environment.
VITE_GOOGLE_ADS_PURCHASE_LABEL=

# PeptidePay (secondary checkout option). Server secrets are stored via the
# Lovable secret store: PEPTIDEPAY_API_KEY, PEPTIDEPAY_WEBHOOK_SECRET,
# PEPTIDEPAY_WALLET. This flag only toggles the client-side checkout card.
VITE_PEPTIDEPAY_ENABLED=true

# PeptidePay server credentials (stored in the Lovable secret store, listed
# here for reference only — never commit real values).
#   PEPTIDEPAY_API_KEY must start with sk_live_ (sk_test_ only works on the
#   webhook simulator). When the Authorization header is used, the request body
#   must NOT include `wallet`.
PEPTIDEPAY_API_KEY=sk_live_xxx
PEPTIDEPAY_WALLET=0x0000000000000000000000000000000000000000
PEPTIDEPAY_WEBHOOK_SECRET=whsec_xxx

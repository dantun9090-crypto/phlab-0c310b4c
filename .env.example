# Wallid payment reconciliation cron.
# Shared between the /api/public/hooks/reconcile-payments route (reads it as
# process.env.CRON_SECRET) and the wallid-reconcile.yml GitHub Actions
# workflow (reads it as secrets.CRON_SECRET). Rotate in lockstep.
CRON_SECRET=your-cron-secret-here

# Google Ads purchase conversion label (client-safe, build time).
# Optional override. The live label for AW-18173004380 is hardcoded as the
# default in src/lib/analytics.ts (YLzWCKDk7MIcENyUyNlD) — only set this if
# you need a different conversion action per environment.
VITE_GOOGLE_ADS_PURCHASE_LABEL=
